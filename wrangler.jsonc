{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "tiga-capsule",
	"compatibility_date": "2026-08-16",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],

	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},

	"vars": {
		"NEXT_PUBLIC_API_URL": "[https://db-tiga.fly.dev](https://db-tiga.fly.dev)",
		"GROQ_CHARACTER_MODEL": "openai/gpt-oss-20b"
	},

	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "tiga-capsule"
		}
	],

	"images": {
		"binding": "IMAGES"
	}
}